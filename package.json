{
	"name": "muum-repo-explorer",
	"version": "1.0.0",
	"description": "Open-source repository discovery and maintenance triage for web and macOS.",
	"private": true,
	"homepage": "https://muum.dev",
	"author": "Murat Umutlu",
	"main": "electron/main.cjs",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"build:web": "next build",
		"build:mac": "npm run build:web && electron-builder --mac --publish never",
		"deploy:cloudflare": "npm run build:web && wrangler pages deploy out --project-name muum-repo-explorer",
		"dev:cloudflare": "npm run build:web && wrangler pages dev out --d1=DB --r2=REPO_BUCKET",
		"db:migrate:local": "wrangler d1 migrations apply muum-repo-explorer --local",
		"db:migrate:remote": "wrangler d1 migrations apply muum-repo-explorer --remote",
		"analyze": "ANALYZE=true next build",
		"start": "next start",
		"export": "next build",
		"typecheck": "tsc --noEmit",
		"lint": "next lint && npm run lint:stylelint",
		"lint:stylelint": "stylelint 'components/**/*.css' --cache",
		"jest": "jest",
		"jest:watch": "jest --watch",
		"prettier:check": "prettier --check \"**/*.{ts,tsx}\"",
		"prettier:write": "prettier --write \"**/*.{ts,tsx}\"",
		"test": "npm run prettier:check && npm run lint && npm run typecheck && npm run jest",
		"storybook": "storybook dev -p 6006",
		"storybook:build": "storybook build"
	},
	"build": {
		"appId": "dev.muum.repo-explorer",
		"productName": "Muum Repo Explorer",
		"directories": {
			"output": "dist/macos"
		},
		"files": [
			"electron/**/*",
			"out/**/*",
			"package.json"
		],
		"mac": {
			"category": "public.app-category.developer-tools",
			"target": [
				"dmg",
				"zip"
			]
		}
	},
	"dependencies": {
		"@clerk/nextjs": "^6.12.8",
		"@mantine/core": "7.6.1",
		"@mantine/hooks": "7.6.1",
		"@next/bundle-analyzer": "^14.1.3",
		"@reduxjs/toolkit": "^2.2.1",
		"@tabler/icons-react": "^3.0.0",
		"@tanstack/react-query": "^5.28.4",
		"gray-matter": "^4.0.3",
		"next": "14.1.3",
		"react": "18.2.0",
		"react-data-grid": "7.0.0-beta.43",
		"react-dom": "18.2.0",
		"react-redux": "^9.1.0",
		"redux-persist": "^6.0.0"
	},
	"devDependencies": {
		"@babel/core": "^7.24.0",
		"@next/eslint-plugin-next": "^14.1.3",
		"@storybook/addon-essentials": "^8.0.0",
		"@storybook/addon-styling-webpack": "^0.0.6",
		"@storybook/blocks": "^8.0.0",
		"@storybook/nextjs": "^8.0.0",
		"@storybook/react": "^8.0.0",
		"@storybook/testing-library": "^0.2.2",
		"@testing-library/dom": "^9.3.4",
		"@testing-library/jest-dom": "^6.4.2",
		"@testing-library/react": "^14.2.1",
		"@testing-library/user-event": "^14.5.2",
		"@types/jest": "^29.5.12",
		"@types/node": "^20.11.26",
		"@types/react": "18.2.65",
		"@typescript-eslint/eslint-plugin": "^7.2.0",
		"@typescript-eslint/parser": "^7.2.0",
		"babel-loader": "^9.1.3",
		"electron": "^42.3.2",
		"electron-builder": "^26.8.1",
		"eslint": "^8.57.0",
		"eslint-config-airbnb": "19.0.4",
		"eslint-config-airbnb-typescript": "^18.0.0",
		"eslint-config-mantine": "3.2.0",
		"eslint-plugin-import": "^2.29.1",
		"eslint-plugin-jest": "^27.9.0",
		"eslint-plugin-jsx-a11y": "^6.8.0",
		"eslint-plugin-react": "^7.34.0",
		"eslint-plugin-react-hooks": "^4.6.0",
		"eslint-plugin-testing-library": "^6.2.0",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"postcss": "^8.4.35",
		"postcss-preset-mantine": "1.13.0",
		"postcss-simple-vars": "^7.0.1",
		"prettier": "^3.2.5",
		"storybook": "^8.0.0",
		"storybook-dark-mode": "^3.0.3",
		"stylelint": "^16.2.1",
		"stylelint-config-standard-scss": "^13.0.0",
		"ts-jest": "^29.1.2",
		"typescript": "5.4.2",
		"wrangler": "^4.97.0"
	}
}
